{
  "name": "jarvis-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell for Jarvis-V1 - owns the kill switch so it works even if the backend it launches is broken or has self-modified.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "reseal": "npm run build && node dist/rebaseline.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.0"
  }
}
