# App
APP_ENV=development
PORT=8080
BASE_DATA_PATH=./data

# Auth
JWT_SECRET=change-me-in-production
API_KEY_HASH=

# Database (MongoDB)
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=command_os
DATABASE_TIMEOUT_MS=5000

# Cache / Queue
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=86400
QUEUE_MAX_CONCURRENCY=5

# Scheduler
SCHEDULER_SCAN_INTERVAL_MS=60000
SCHEDULER_TIMEZONE=UTC

# Browser
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=15000

# AI
AI_DEFAULT_MODEL=claude-3-5-sonnet
AI_FALLBACK_MODEL=gemini-1-5-flash
AI_LOCAL_MODEL=llama3
AI_MONTHLY_LIMIT_USD=50
AI_PROVIDER_KEY=
