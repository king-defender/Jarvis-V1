# App
APP_ENV=development
PORT=8080
BASE_DATA_PATH=./data

# Auth
JWT_SECRET=change-me-in-production
ENCRYPTION_KEY=change-me-encryption-key
API_KEY_HASH=

# Database (MongoDB)
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=command_os
DATABASE_TIMEOUT_MS=5000

# Cache / Queue
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=86400
QUEUE_MAX_CONCURRENCY=5

# Scheduler
SCHEDULER_SCAN_INTERVAL_MS=60000
SCHEDULER_TIMEZONE=UTC

# Browser (auto | playwright | fetch)
BROWSER_ENGINE=auto
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=15000

# AI — configure any tier; router fails over Anthropic → Gemini → Ollama → offline
AI_DEFAULT_MODEL=claude-3-5-sonnet-20241022
AI_FALLBACK_MODEL=gemini-1.5-flash
AI_LOCAL_MODEL=llama3
AI_MONTHLY_LIMIT_USD=50
AI_PROVIDER_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Email (optional SMTP; otherwise queues locally)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=commandos@localhost

# Integrations
GITHUB_TOKEN=
SEARCH_API_URL=
SLACK_WEBHOOK_URL=
